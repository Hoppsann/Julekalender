<%- include("./partials/head") %>
<body>
  <div class="wrapper2">
    <%- include("./partials/nav") %>
    <main id="lukewrapper">
      <div id="luke">

        <h1>Luke <%= luke.dag %></h1>
        <p><%= luke.question %></p>

        <% if (luke.type === 'video' && luke.video_url) { %>
          <iframe width="560" height="315"
                  src="<%= luke.video_url.replace('watch?v=', 'embed/') %>"
                  title="Video til luke <%= luke.dag %>"
                  allowfullscreen></iframe>
        <% } %>

        <% if (luke.winner) { %>
          <p class="vinner">Vinner: <strong><%= visNavn(luke.winner.email) %></strong></p>
        <% } %>

        <% if (svar) { %>
          <p>Du har svart: <strong><%= svar.answer %></strong></p>
        <% } else { %>
          <form method="POST" action="/luke/<%= luke.dag %>">
            <% if (luke.type === 'multiple_choice') { %>
                <% luke.options.forEach(option => { %>
                  <label>
                    <input type="radio" name="answer" value="<%= option %>" required>
                    <%= option %>
                  </label>
                <% }) %>
            <% } else { %>
              <label for="answer">Ditt svar</label>
              <input type="text" id="answer" name="answer" required>
            <% } %>
            <button type="submit">Send svar</button>
          </form>
        <% } %>

      </div>
    </main>
  </div>
</body>
</html>