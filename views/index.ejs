<%- include("./partials/head") %>

<body>
  <div class="wrapper2">
    <div style="text-align: center; padding-top: 1rem;">
      <label for="dato">Velg dag (0–25): </label>
      <input type="number" id="dato" min="0" max="25">
    </div>  
    <div class="wrapper">
      <div class="kalender">
        <% for (let dag = 1; dag <= 24; dag++) { %>
          <div class="luke" data-dag="<%= dag %>"><%= dag %></div>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>