<%- include("./partials/head") %>
<body>
    <div class="wrapper2">
        <%- include("./partials/nav") %>

        <main class="dashbord">

            <section id="dag" class="panel">
                <h2>Dag</h2>
                <% if (visTestdag) { %>
                    <form method="POST" action="/testdag" class="dag-form">
                        <label for="testdag">Testdag (0-25)</label>
                        <input type="number" id="testdag" name="dag" min="0" max="25" value="<%= idag %>">
                        <button type="submit">Sett dag</button>
                    </form>
                <% } %>
            </section>

            <section id="svar" class="panel">
                <h2>Svar - luke <%= valgtDag %></h2>

                
                <ul class="svar-liste">
                <% alleSvar.forEach(s => { %>
                    <li class="svar-rad">
                    <span>
                        
                        Luke <%= s.luke ? s.luke.dag : '?' %>
                         <% if (s.luke) { %>
                            <small class="fasit">(fasit: <%= s.luke.correct_answer %>)</small>
                        <% } %> -
                        <%= s.user ? s.user.email : 'Slettet bruker' %>:
                        <strong><%= s.answer %></strong>
                    </span>

                    <form method="POST" action="/dashbord/svar/<%= s._id %>" class="vurder">
                        <button name="correct" value="true"
                                class="riktig <%= s.correct === true ? 'valgt' : '' %>"
                                aria-label="Marker som riktig">✓</button>
                        <button name="correct" value="false"
                                class="galt <%= s.correct === false ? 'valgt' : '' %>"
                                aria-label="Marker som galt">✗</button>
                    </form>
                    </li>
                <% }) %>
                </ul>                

            </section>

            
            <section id="brukere" class="panel">
                <h2>Brukere (<%= users.length %>)</h2>

                <% if (users.length === 0) { %>
                    <p>Ingen brukere ennå.</p>
                <% } else { %>
                    <ul class="user-list">
                        <% users.forEach(user => { %>
                            <li class="user">
                                <span class="user-email"><%= user.email %></span>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </section>
                <section id="trekning" class="panel">
                    <h2>Trekning - luke <%= valgtDag %></h2>

                    <form method="GET" action="/dashbord" class="dag-velger">
                        <label for="dag-velger">Velg luke</label>
                        <input type="number" id="dag-velger" name="dag" min="1" max="24" value="<%= valgtDag %>">
                        <button type="submit">Vis</button>
                    </form>

                    <% if (!luke) { %>
                        <p>Luke <%= valgtDag %> finnes ikke.</p>
                    <% } else if (luke.winner) { %>
                        <p>Vinner: <strong><%= luke.winner.email %></strong></p>
                    <% } else if (antallRiktige === 0) { %>
                        <p>Ingen riktige svar på luke <%= valgtDag %> ennå.</p>
                    <% } else { %>
                        <p><%= antallRiktige %> har svart riktig.</p>
                        <form method="POST" action="/dashbord/trekk">
                            <input type="hidden" name="dag" value="<%= valgtDag %>">
                            <button type="submit">Trekk vinner</button>
                        </form>
                    <% } %>
                </section>
            </section>

        </main>
    </div>
</body>
</html>