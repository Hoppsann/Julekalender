<%- include("./partials/head") %>
<body>
    <div class="wrapper2">
        <%- include("./partials/nav") %>
        <main id="register">
            <form method="POST" action="/register">
                <h1>Logg inn med AFK-e-post</h1>

                <% if (feil) { %>
                    <p class="tilbakemelding galt" role="alert"><%= feil %></p>
                <% } %>

                <label for="email">E-post</label>
                <input type="email"
                       id="email"
                       name="email"
                       placeholder="navn@afk.no"
                       pattern=".+@afk\.no"
                       autocomplete="email"
                       required>
                <button type="submit">Fortsett</button>
            </form>
        </main>
    </div>
</body>
</html>